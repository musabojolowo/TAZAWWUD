{
  "rules": {
    ".read": false,
    ".write": false,
    "bookmarks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$bookmarkKey": {
          ".validate": "newData.hasChildren(['surah', 'ayah', 'ts']) && newData.child('surah').isNumber() && newData.child('surah').val() >= 1 && newData.child('surah').val() <= 114 && newData.child('ayah').isNumber() && newData.child('ayah').val() >= 1 && newData.child('ayah').val() <= 286 && newData.child('ts').isNumber()",
          "surah": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 114"
          },
          "ayah": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 286"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        ".validate": "true"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "preferences": {
          ".validate": "true",
          "$prefKey": {
            ".validate": "newData.isString() ? newData.val().length <= 2000 : true"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "stories": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$storyId": {
        ".validate": "newData.hasChildren(['title', 'body', 'published', 'createdAt', 'updatedAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20000"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "imageUrl": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "published": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "createdBy": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "progress": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "lastSurah": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 114"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "dailyContent": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$date": {
        "verse": {
          ".validate": "newData.hasChildren(['surahNumber', 'ayahNumber', 'surahName', 'arabicText', 'translation'])",
          "surahNumber": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 114"
          },
          "ayahNumber": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 286"
          },
          "surahName": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "arabicText": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "translation": {
            ".validate": "newData.isString() && newData.val().length <= 4000"
          },
          "$other": {
            ".validate": false
          }
        },
        "hadith": {
          ".validate": "newData.hasChildren(['collection', 'reference', 'text'])",
          "collection": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "reference": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 6000"
          },
          "grade": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "$other": {
            ".validate": false
          }
        },
        "announcement": {
          ".validate": "newData.hasChildren(['title', 'body', 'active'])",
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "body": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reminders": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$reminderId": {
        ".validate": "newData.hasChildren(['title', 'time', 'enabled', 'updatedAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "time": {
          ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
        },
        "enabled": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "immediateReminders": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".validate": "newData.hasChildren(['title', 'body', 'createdAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reminderLog": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$entry": {
        ".validate": "newData.hasChildren(['action', 'title', 'at', 'by'])",
        "action": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}